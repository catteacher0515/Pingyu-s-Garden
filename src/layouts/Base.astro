---
import '../styles/global.css'
import site from '../data/site.json'
import { getSearchIndex, getSectionPresence } from '../lib/content'

interface Props {
  title?: string
  description?: string
  nav?: 'videos' | 'writing' | 'rants'
}
const { title, description = site.tagline, nav } = Astro.props
const pageTitle = title ? `${title} · 花萍雨` : '花萍雨 · Pingyu'
const search = await getSearchIndex()
const has = await getSectionPresence()
const links = [
  has.videos && { id: 'videos', href: '/videos/', label: '视频' },
  (has.posts || has.notes) && { id: 'writing', href: '/writing/', label: '教程 & 笔记' },
  has.rants && { id: 'rants', href: '/rants/', label: '发发神经' },
].filter((l) => !!l)
const follow = site.follow.filter((f) => f.url)
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <div class="cur" id="cur"><span></span></div>

    <header class="bar">
      <a class="brand" href="/">{site.name} / Pingyu</a>
      <nav>
        {links.map((l) => <a class:list={['ulink', { on: nav === l.id }]} href={l.href}>{l.label}</a>)}
        {follow.length > 0 && <a class="ulink" href="#follow">关注我</a>}
        <button class="ulink" data-open-search>搜索 ⌘K</button>
      </nav>
    </header>

    <slot />

    <footer class="follow" id="follow">
      <h2 class="follow-title">关注我<span class="dot">.</span></h2>
      {follow.length > 0 && (
        <div class="plats">
          {follow.map((f) => (
            <a class="plat" href={f.url} target={f.url.startsWith('http') ? '_blank' : undefined} rel="noopener" data-cursor="去看看">
              <b>{f.name}</b><span>{f.handle || '→'}</span>
            </a>
          ))}
        </div>
      )}
      <div class="foot"><span>© {new Date().getFullYear()} {site.name}</span><span>Built slowly.</span></div>
    </footer>

    <div class="pal" id="pal">
      <div class="box">
        <input id="q" placeholder="搜索视频、教程、笔记…" autocomplete="off" />
        <div class="res" id="res"></div>
      </div>
    </div>
    <script is:inline id="search-data" type="application/json" set:html={JSON.stringify(search)}></script>

    <script>
      import { gsap } from 'gsap'
      import { SplitText } from 'gsap/SplitText'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'
      gsap.registerPlugin(SplitText, ScrollTrigger)
      if (import.meta.env.DEV) (window as unknown as { gsap: typeof gsap }).gsap = gsap

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
      const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches

      // 自定义光标：悬停在带 data-cursor 的元素上会放大并显示文字
      const cur = document.getElementById('cur')!
      const label = cur.querySelector('span')!
      if (finePointer && !reduce) {
        document.body.classList.add('has-cursor')
        const xTo = gsap.quickTo(cur, 'x', { duration: .35, ease: 'power3' })
        const yTo = gsap.quickTo(cur, 'y', { duration: .35, ease: 'power3' })
        addEventListener('pointermove', (e) => { xTo(e.clientX); yTo(e.clientY); gsap.to(cur, { opacity: 1, duration: .2 }) })
        document.addEventListener('mouseleave', () => gsap.to(cur, { opacity: 0, duration: .2 }))
        document.addEventListener('mouseover', (e) => {
          const el = (e.target as HTMLElement).closest<HTMLElement>('a, button, [data-cursor]')
          const t = el?.dataset.cursor
          gsap.to(cur, { width: el ? (t ? 84 : 36) : 12, height: el ? (t ? 84 : 36) : 12, margin: el ? (t ? -42 : -18) : -6, duration: .4, ease: 'expo.out' })
          label.textContent = t || ''
          gsap.to(label, { opacity: t ? 1 : 0, duration: .2 })
        })
      }

      // 页脚「关注我」逐字出现
      if (!reduce) {
        const fs = new SplitText('.follow-title', { type: 'chars' })
        gsap.from(fs.chars, { yPercent: 120, stagger: .05, duration: 1.1, ease: 'expo.out', scrollTrigger: { trigger: '.follow', start: 'top 75%' } })
      }

      // 悬停列表：跟随光标的预览卡（任何页面的 .list 都生效）
      document.querySelectorAll<HTMLElement>('.list').forEach((list) => {
        const peek = document.createElement('div')
        peek.className = 'peek'
        document.body.appendChild(peek)
        const px = gsap.quickTo(peek, 'x', { duration: .5, ease: 'power3' })
        const py = gsap.quickTo(peek, 'y', { duration: .5, ease: 'power3' })
        list.querySelectorAll<HTMLElement>('.row').forEach((r) => {
          r.addEventListener('mouseenter', () => {
            peek.style.background = r.dataset.bg || '#141414'
            peek.innerHTML = r.dataset.img ? `<img src="${r.dataset.img}" alt="">` : ''
            if (!r.dataset.img) peek.textContent = r.dataset.title || ''
            gsap.to(peek, { opacity: 1, scale: 1, rotate: gsap.utils.random(-6, 6), duration: .5, ease: 'expo.out' })
          })
          r.addEventListener('mouseleave', () => gsap.to(peek, { opacity: 0, scale: .6, duration: .3 }))
        })
        addEventListener('pointermove', (e) => { px(e.clientX + 30); py(e.clientY - 130) })
        addEventListener('scroll', () => gsap.to(peek, { opacity: 0, scale: .6, duration: .2 }), { passive: true })
      })

      // ⌘K 搜索
      type Item = { title: string; label: string; href: string; cover?: string; text: string }
      const all: Item[] = JSON.parse(document.getElementById('search-data')!.textContent || '[]')
      const pal = document.getElementById('pal')!
      const q = document.getElementById('q') as HTMLInputElement
      const res = document.getElementById('res')!
      let sel = 0
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!)
      function draw() {
        const v = q.value.trim().toLowerCase()
        const list = all.filter((x) => !v || (x.title + x.label + x.text).toLowerCase().includes(v)).slice(0, 12)
        sel = Math.min(sel, Math.max(list.length - 1, 0))
        res.innerHTML = list.length
          ? list.map((x, i) => `<a href="${esc(x.href)}" class="${i === sel ? 'on' : ''}"${x.href.startsWith('http') ? ' target="_blank" rel="noopener"' : ''}>${esc(x.title)}<small>${esc(x.label)}</small></a>`).join('')
          : `<p style="padding:16px;color:var(--mute)">${all.length ? '没有找到' : '还没有内容可以搜'}</p>`
      }
      function open() { pal.classList.add('show'); q.value = ''; sel = 0; draw(); q.focus(); if (!reduce) gsap.from('.pal .box', { y: -14, opacity: 0, duration: .35, ease: 'expo.out' }) }
      const close = () => pal.classList.remove('show')
      q.addEventListener('input', () => { sel = 0; draw() })
      q.addEventListener('keydown', (e) => {
        const items = res.querySelectorAll('a'); const n = items.length
        if (!n) return
        if (e.key === 'ArrowDown') { sel = (sel + 1) % n; draw(); e.preventDefault() }
        if (e.key === 'ArrowUp') { sel = (sel - 1 + n) % n; draw(); e.preventDefault() }
        if (e.key === 'Enter') (items[sel] as HTMLAnchorElement).click()
      })
      document.querySelectorAll('[data-open-search]').forEach((b) => b.addEventListener('click', open))
      pal.addEventListener('click', (e) => { if (e.target === pal) close() })
      addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open() }
        if (e.key === 'Escape') close()
      })
    </script>
  </body>
</html>
