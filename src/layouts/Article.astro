---
import Base from './Base.astro'

export type TocItem = { id: string; text: string; depth: number }
interface Props {
  title: string
  description?: string
  nav: 'videos' | 'notes' | 'articles' | 'projects'
  back: { href: string; label: string }
  toc?: TocItem[]
  image?: string
}
const { title, description, nav, back, toc = [], image } = Astro.props
// 目录只显示文章里最高的两级标题，全部展开（像文档大纲）
const levels = [...new Set(toc.map((t) => t.depth))].sort((a, b) => a - b).slice(0, 2)
const items: (TocItem & { rank: number; parent: number })[] = []
const lastAt: number[] = []
for (const t of toc) {
  const rank = levels.indexOf(t.depth)
  if (rank < 0) continue
  lastAt.length = rank
  // 父级取最近的上一层；中间跳级（如 h3 下直接是 h5）时往上找
  let parent = -1
  for (let r = rank - 1; r >= 0; r--) if (lastAt[r] !== undefined) { parent = lastAt[r]; break }
  lastAt[rank] = items.length
  items.push({ ...t, rank, parent })
}
---
<Base title={title} description={description} nav={nav} image={image}>
  <div class="progress" aria-hidden="true"><i id="progress"></i></div>
  <header class="page-head art-head">
    <a class="eyebrow ulink" href={back.href}>← {back.label}</a>
    <h1>{title}</h1>
    <div class="meta"><slot name="meta" /></div>
  </header>
  <slot name="hero" />
  <div class="art">
    <article class="prose"><slot /></article>
    {items.length > 0 && (
      <aside class="toc">
        <p>本页目录</p>
        <nav>
          {items.map((t, i) => <a href={`#${t.id}`} data-id={t.id} data-i={i} data-rank={t.rank} data-parent={t.parent} class:list={[`r${t.rank}`]}>{t.text}</a>)}
        </nav>
      </aside>
    )}
  </div>
  <slot name="after" />
</Base>

<style>
  .progress { position: fixed; left: 0; right: 0; top: 0; height: 3px; z-index: 60; }
  .progress i { display: block; height: 100%; background: var(--hot); transform-origin: left; transform: scaleX(0); }
  .art-head h1 { font-size: clamp(38px, 4.2vw, 64px); line-height: 1.15; letter-spacing: -.03em; max-width: 1100px; }
  .art-head .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 26px; color: var(--mute); font-size: 15px; }
  .art { display: grid; grid-template-columns: minmax(0, 760px) 240px; justify-content: space-between; gap: 60px; padding: 30px var(--pad) 0; }
  .toc { position: sticky; top: 110px; align-self: start; font-size: 14px; max-height: calc(100vh - 150px); display: flex; flex-direction: column; }
  .toc p { color: var(--mute); margin-bottom: 12px; flex: none; }
  .toc nav { overflow-y: auto; overscroll-behavior: contain; padding-right: 6px; scrollbar-width: thin; }
  .toc a { display: block; padding: 6px 0 6px 14px; border-left: 1px solid var(--line); color: var(--mute); line-height: 1.45; transition: color .2s, border-color .2s; }
  .toc a.r1 { padding-left: 28px; font-size: 13px; }
  .toc a:hover { color: var(--ink); }
  .toc a.trail { color: var(--ink); }
  .toc a.on { color: var(--ink); font-weight: 600; border-left-color: var(--hot); }
</style>

<script>
  // 阅读进度条
  const bar = document.getElementById('progress')!
  const setProgress = () => {
    const max = document.documentElement.scrollHeight - innerHeight
    bar.style.transform = `scaleX(${max > 0 ? Math.min(scrollY / max, 1) : 0})`
  }
  addEventListener('scroll', setProgress, { passive: true })
  setProgress()

  // 滚动时高亮当前小节和它所在的章节
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc nav a')]
  if (links.length) {
    const nav = document.querySelector<HTMLElement>('.toc nav')!
    const heads = links.map((a) => document.getElementById(decodeURIComponent(a.dataset.id || '')))
    const parentOf = links.map((a) => Number(a.dataset.parent))
    let last = -2
    const update = () => {
      let cur = 0
      heads.forEach((h, i) => { if (h && h.getBoundingClientRect().top < 160) cur = i })
      if (cur === last) return
      last = cur
      const trail = new Set<number>()
      for (let i = cur; i >= 0; i = parentOf[i]) trail.add(i)
      links.forEach((a, i) => {
        a.classList.toggle('on', i === cur)
        a.classList.toggle('trail', trail.has(i) && i !== cur)
      })
      const active = links[cur]
      const top = active.offsetTop - nav.offsetTop
      if (top < nav.scrollTop + 20 || top > nav.scrollTop + nav.clientHeight - 40) nav.scrollTo({ top: top - nav.clientHeight / 3, behavior: 'smooth' })
    }
    addEventListener('scroll', update, { passive: true })
    update()
  }
</script>
