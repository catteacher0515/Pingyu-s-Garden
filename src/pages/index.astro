---
import Base from '../layouts/Base.astro'
import site from '../data/site.json'
import { opt } from '../lib/img'
import { getVideos, getRants, getWritingRows, getProjects, projectPageHref, videoHref, thumb, fmtDay } from '../lib/content'

const [videos, rants, rows, projects] = await Promise.all([getVideos(), getRants(), getWritingRows(), getProjects()])
const latestVideos = videos.slice(0, 4)
const writing = rows.slice(0, 4)
let n = 0
const no = () => String(++n).padStart(2, '0')
---
<Base>
  <section class="hero screen">
    <div class="hero-text">
      <p class="role reveal">{site.role}</p>
      <h1 id="name">{site.name}<span class="dot">.</span></h1>
      <p class="sub reveal" style="--d:.5s">{site.tagline}</p>
      <p class="now reveal" style="--d:.6s"><i></i><span id="now" data-now={JSON.stringify(site.now)}>{site.now[0]}</span></p>
    </div>
    <div class="ip" id="ip">
      <img class="ip-img" src="/brand/laptop.webp" alt="花萍雨的 IP 形象" />
    </div>
  </section>

  {projects.length > 0 && (
    <section id="projects" class="screen">
      <div class="sh"><h2>{no()} · 项目</h2><span>正在做的 Agent 和工程项目</span></div>
      <div class="projects">
        {projects.map((p, i) => {
          const Tag = p.data.wip ? 'div' : 'a'
          return (
            <Tag class:list={['proj', 'reveal-scroll', { wip: p.data.wip }]} href={p.data.wip ? undefined : projectPageHref(p)} data-cursor={p.data.wip ? undefined : '看详情'}>
              <div class="pcover">{p.data.cover ? <img src={opt(p.data.cover)} alt="" loading="lazy" /> : <div class="bg" style={`background:${thumb(i)}`}></div>}</div>
              <div class="pmeta">
                <div class="ptop"><span class="pno">{String(i + 1).padStart(2, '0')}</span>{p.data.wip && <span class="pwip"><i></i>开发中</span>}{p.data.period && <span class="pperiod">{p.data.period}</span>}</div>
                <h3>{p.data.title}</h3>
                <p class="ptag">{p.data.tagline}</p>
                {p.data.stack.length > 0 && <div class="pstack">{p.data.stack.map((t) => <span>{t}</span>)}</div>}
                {!p.data.wip && <span class="pgo">项目详情 →</span>}
              </div>
            </Tag>
          )
        })}
      </div>
    </section>
  )}

  {writing.length > 0 && (
    <section id="writing" class="screen">
      <div class="sh"><h2>{no()} · 笔记</h2><a class="ulink" href="/writing/">全部 {rows.length} 篇 →</a></div>
      <div class="notes-wrap">
        <div class="notes-ip">
          <img src="/brand/notes.webp" alt="" loading="lazy" />
          <p>边学边记，<br />一直在更新。</p>
        </div>
        <div class="notes-list">
          {writing.map((r) => (
            <a class="nrow reveal-scroll" href={r.href} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener' : undefined}>
              <span class="nk">{r.kind}</span>
              <h3>{r.title}</h3>
              <span class="nm">{r.meta}</span>
              <span class="ngo">→</span>
            </a>
          ))}
          {rows.length < 4 && <p class="nmore">更多笔记正在整理，会陆续放上来。</p>}
        </div>
      </div>
    </section>
  )}

  {videos.length > 0 && (
    <section id="videos" class="screen">
      <div class="sh"><h2>{no()} · 视频</h2><a class="ulink" href="/videos/">全部 {videos.length} 支 →</a></div>
      <div class="vgrid">
        {latestVideos.map((v, i) => (
          <a class="vcard reveal-scroll" href={videoHref(v)} data-cursor="播放">
            <div class="frame">
              {v.data.cover ? <img src={opt(v.data.cover)} alt="" loading="lazy" /> : <div class="bg" style={`background:${thumb(i)}`}></div>}
              {v.data.preview && <video src={v.data.preview} muted loop playsinline preload="none" data-hover-preview></video>}
              {v.data.duration && <span class="len mono">{v.data.duration}</span>}
            </div>
            <div class="meta"><span>{v.data.tags[0] ?? v.data.platform}</span><span>{fmtDay(v.data.date)}{v.data.draft && ' · 草稿'}</span></div>
            <h3>{v.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  {rants.length > 0 && (
    <section id="rants" class="screen">
      <div class="sh"><h2>发发神经</h2><a class="ulink" href="/rants/">全部 →</a></div>
      <a class="rants" href="/rants/" data-cursor="去看看">
        <div class="rline" id="rline">
          {[0, 1].map(() => rants.slice(0, 6).map((r) => (
            <span><em>{r.data.mood ?? '💬'}</em>{r.body?.trim().split('\n')[0]}<small class="mono">{fmtDay(r.data.date)}</small></span>
          )))}
        </div>
      </a>
    </section>
  )}
</Base>

<style is:global>
  /* 首页：一屏只放一块内容，滚动时吸附到整屏 */
  html { scroll-snap-type: y mandatory; }
</style>

<style>
  .screen { min-height: 100vh; scroll-snap-align: start; display: flex; flex-direction: column; justify-content: center; padding: 90px 0 50px; }
  .screen > .sh { margin-bottom: 10px; }
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; gap: 48px; padding: 90px var(--pad) 40px; }
  .role { font-size: 16px; font-weight: 600; color: var(--navy); margin-bottom: 18px; letter-spacing: .02em; }
  .hero h1 { font-size: clamp(110px, 12.5vw, 230px); line-height: .82; letter-spacing: -.06em; font-weight: 850; white-space: nowrap; }
  .sub { margin-top: 28px; font-size: 22px; line-height: 1.55; max-width: 600px; }
  .now { margin-top: 24px; display: flex; align-items: center; gap: 10px; color: var(--ink); font-size: 15px; }
  .now i { width: 8px; height: 8px; border-radius: 50%; background: var(--hot); animation: blink 1.4s infinite; }
  @keyframes blink { 50% { opacity: .25; } }
  .ip { position: relative; justify-self: center; width: min(30vw, 480px); animation: pop 1.2s var(--ease) .2s backwards; }
  @keyframes pop { from { opacity: 0; transform: translateY(40px) scale(.94); } }
  .ip::before { content: ''; position: absolute; left: 8%; right: 8%; bottom: 2%; height: 70%; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--hot) 45%, transparent), transparent); filter: blur(30px); z-index: -1; }
  .ip-img { width: 100%; max-height: 72vh; object-fit: contain; animation: float 6s ease-in-out infinite; }
  @keyframes float { 50% { transform: translateY(-14px); } }


  /* 项目：三列卡片 */
  .projects { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 30px var(--pad) 0; }
  .proj { display: flex; flex-direction: column; background: var(--paper2); border-radius: 18px; overflow: hidden; transition: transform .5s var(--ease), box-shadow .5s var(--ease); }
  a.proj:hover { transform: translateY(-6px); box-shadow: 0 30px 60px rgba(19, 28, 70, .12); }
  .pcover { position: relative; height: min(32vh, 300px); background: linear-gradient(180deg, color-mix(in srgb, var(--hot) 18%, var(--paper2)), var(--paper2)); }
  .pcover img { position: absolute; inset: 16px 20px 0; width: calc(100% - 40px); height: calc(100% - 16px); object-fit: contain; object-position: bottom; transition: transform .8s var(--ease); }
  .pcover .bg { position: absolute; inset: 0; }
  .proj:hover .pcover img { transform: scale(1.04) rotate(-1.5deg); }
  .pmeta { padding: 20px 28px 28px; display: flex; flex-direction: column; flex: 1; }
  .ptop { display: flex; align-items: center; gap: 12px; font-size: 14px; }
  .pno { font-weight: 700; color: var(--navy); }
  .pwip { display: inline-flex; align-items: center; gap: 6px; background: var(--night); color: var(--paper); border-radius: 999px; padding: 3px 10px 3px 8px; font-size: 12px; font-weight: 600; }
  .pwip i { width: 7px; height: 7px; border-radius: 50%; background: var(--hot); animation: blink 1.4s infinite; }
  .pperiod { color: var(--mute); }
  .proj h3 { font-size: 30px; letter-spacing: -.03em; line-height: 1.15; margin-top: 10px; }
  .ptag { font-size: 16px; line-height: 1.7; margin-top: 12px; color: #3d4160; }
  .pstack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 20px; }
  .pstack span { border: 1px solid var(--ink); border-radius: 999px; padding: 3px 11px; font-size: 12px; font-weight: 600; }
  .pgo { margin-top: 20px; font-weight: 700; border-bottom: 2px solid var(--hot); align-self: flex-start; }

  /* 笔记：左边 IP 形象，右边列表 */
  .notes-wrap { display: grid; grid-template-columns: 1fr 2fr; gap: 50px; align-items: center; padding: 30px var(--pad) 0; }
  .notes-ip { text-align: center; }
  .notes-ip img { width: min(100%, 340px); max-height: 46vh; object-fit: contain; margin: 0 auto; }
  .notes-ip p { margin-top: 18px; font-size: 26px; font-weight: 700; line-height: 1.4; letter-spacing: -.01em; }
  .notes-list { display: grid; gap: 14px; }
  .nrow { display: grid; grid-template-columns: 80px 1fr auto 30px; align-items: center; gap: 16px; padding: 26px 28px; border-radius: 14px; background: #fff; border: 1px solid var(--line); transition: transform .4s var(--ease), border-color .3s, box-shadow .4s; }
  .nrow:hover { transform: translateX(6px); border-color: var(--navy); box-shadow: 0 20px 40px rgba(19, 28, 70, .08); }
  .nrow .nk { font-size: 13px; font-weight: 700; color: var(--navy); }
  .nrow h3 { font-size: 24px; letter-spacing: -.01em; }
  .nrow .nm { font-size: 14px; color: var(--mute); }
  .nrow .ngo { font-size: 20px; text-align: right; }
  .nmore { padding: 22px 28px; border-radius: 14px; border: 1.5px dashed var(--line); color: var(--mute); font-size: 15px; }

  /* 视频：普通网格，不锁滚动 */
  .vgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; padding: 30px var(--pad) 0; }
  .vgrid .vcard h3 { font-size: 18px; line-height: 1.45; }

  .rants { display: block; padding: 60px 0 20px; overflow: hidden; }
  .rline { display: flex; gap: 80px; white-space: nowrap; width: max-content; font-size: 48px; letter-spacing: -.02em; }
  .rline span { display: inline-flex; gap: 22px; align-items: center; }
  .rline em { font-style: normal; font-size: 36px; }
  .rline small { font-size: 14px; color: var(--mute); }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'
  gsap.registerPlugin(ScrollTrigger, SplitText)
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!reduce) {
    const split = new SplitText('#name', { type: 'chars' })
    gsap.from(split.chars, { yPercent: 110, rotate: 8, opacity: 0, stagger: .07, duration: 1.2, ease: 'expo.out' })
  }

  // 「正在做」轮换
  const nowEl = document.getElementById('now')!
  const nows: string[] = JSON.parse(nowEl.dataset.now || '[]')
  let ni = 0
  if (nows.length > 1 && !reduce) setInterval(() => {
    gsap.to(nowEl, { y: -10, opacity: 0, duration: .3, onComplete: () => {
      ni = (ni + 1) % nows.length; nowEl.textContent = nows[ni]
      gsap.fromTo(nowEl, { y: 10, opacity: 0 }, { y: 0, opacity: 1, duration: .5 })
    } })
  }, 2600)

  // 角色跟随鼠标轻微视差
  const ip = document.getElementById('ip')
  if (ip && !reduce) addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return
    const x = e.clientX / innerWidth - .5, y = e.clientY / innerHeight - .5
    gsap.to(ip, { x: x * -24, y: y * -16, rotate: x * 2, duration: 1, ease: 'power3.out' })
  })

  // 发发神经跑马灯：滚动越快转得越快
  const rline = document.getElementById('rline')
  if (rline && !reduce) {
    const loop = gsap.to(rline, { xPercent: -50, duration: 40, ease: 'none', repeat: -1 })
    ScrollTrigger.create({ onUpdate: (self) => {
      gsap.to(loop, { timeScale: 1 + Math.min(Math.abs(self.getVelocity()) / 300, 6), duration: .2, overwrite: true })
      gsap.to(loop, { timeScale: 1, duration: 1.2, delay: .2 })
    } })
  }

  // 视频卡片悬停播放预览片段
  document.querySelectorAll<HTMLVideoElement>('video[data-hover-preview]').forEach((v) => {
    const card = v.closest('.vcard')!
    card.addEventListener('mouseenter', () => { v.preload = 'auto'; v.play().catch(() => {}) })
    card.addEventListener('mouseleave', () => v.pause())
  })
</script>
