---
import Base from '../layouts/Base.astro'
import site from '../data/site.json'
import { opt } from '../lib/img'
import { getVideos, getRants, getWritingRows, videoHref, thumb, fmtDay } from '../lib/content'

const [videos, rants, rows] = await Promise.all([getVideos(), getRants(), getWritingRows()])
const latest = videos[0]
const pinned = videos.length >= 3 // 视频够多才用横向滚动
const writing = rows.slice(0, 8)
---
<Base>
  <section class="hero">
    <div>
      <h1 id="name">{site.name}<span class="dot">.</span></h1>
      <p class="sub reveal" style="--d:.5s">{site.tagline}</p>
      <p class="now reveal" style="--d:.6s"><i></i><span id="now" data-now={JSON.stringify(site.now)}>{site.now[0]}</span></p>
    </div>
    {latest ? (
      <a class="screen" href={videoHref(latest)} data-cursor="看最新">
        {latest.data.cover ? <img src={opt(latest.data.cover)} alt="" /> : <div class="feed"></div>}
        {latest.data.preview && <video src={latest.data.preview} muted loop playsinline autoplay></video>}
        <div class="grain"></div>
        <div class="rec"><i></i>最新一期{latest.data.draft && <span class="draft-badge">草稿</span>}</div>
        <div class="title">{latest.data.title}</div>
        <div class="hud mono"><span id="tc">00:00:00:00</span><span>{latest.data.duration ?? fmtDay(latest.data.date)}</span></div>
      </a>
    ) : (
      <div class="screen idle">
        <div class="feed"></div><div class="grain"></div>
        <div class="rec"><i></i>频道筹备中</div>
        <div class="title">第一支视频正在剪，<br />很快就来。</div>
        <div class="hud mono"><span id="tc">00:00:00:00</span><span>STANDBY</span></div>
      </div>
    )}
  </section>

  {videos.length > 0 && (
    <section id="videos">
      <div class="sh"><h2>01 · 视频</h2><a class="ulink" href="/videos/">全部 {videos.length} 支 →</a></div>
      {pinned ? (
        <div class="reel" id="reel">
          <div class="track" id="track">
            {videos.map((v, i) => (
              <a class="vcard" href={videoHref(v)} data-cursor="播放">
                <div class="frame">
                  {v.data.cover ? <img src={opt(v.data.cover)} alt="" loading="lazy" /> : <div class="bg" style={`background:${thumb(i)}`}></div>}
                  {v.data.preview && <video src={v.data.preview} muted loop playsinline preload="none" data-hover-preview></video>}
                  <span class="no">{String(i + 1).padStart(2, '0')}</span>{v.data.duration && <span class="len mono">{v.data.duration}</span>}
                </div>
                <div class="meta"><span>{v.data.tags[0] ?? v.data.platform}</span><span>{fmtDay(v.data.date)}{v.data.draft && ' · 草稿'}</span></div>
                <h3>{v.data.title}</h3>
              </a>
            ))}
            <div class="reel-end">全部视频<br />都在 <a href="/videos/">这里 →</a></div>
          </div>
        </div>
      ) : (
        <div class="vgrid">
          {videos.map((v, i) => (
            <a class="vcard reveal-scroll" href={videoHref(v)} data-cursor="播放">
              <div class="frame">
                {v.data.cover ? <img src={opt(v.data.cover)} alt="" loading="lazy" /> : <div class="bg" style={`background:${thumb(i)}`}></div>}
                {v.data.preview && <video src={v.data.preview} muted loop playsinline preload="none" data-hover-preview></video>}
                <span class="no">{String(i + 1).padStart(2, '0')}</span>{v.data.duration && <span class="len mono">{v.data.duration}</span>}
              </div>
              <div class="meta"><span>{v.data.tags[0] ?? v.data.platform}</span><span>{fmtDay(v.data.date)}{v.data.draft && ' · 草稿'}</span></div>
              <h3>{v.data.title}</h3>
            </a>
          ))}
        </div>
      )}
    </section>
  )}

  {writing.length > 0 && (
    <section id="writing" class="block">
      <div class="sh"><h2>{videos.length ? '02' : '01'} · 教程 & 笔记</h2><a class="ulink" href="/writing/">全部 →</a></div>
      <p class="big">写下来的<span class="serif">慢</span>东西</p>
      <div class="list">
        {writing.map((r, i) => (
          <a class="row reveal-scroll" href={r.href} data-title={r.title} data-bg={thumb(i + 1)} data-img={r.cover} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener' : undefined}>
            <span class="k">{r.kind}{r.draft && ' · 草稿'}</span><span>{r.title}</span><small>{r.meta}</small><small class="go">{r.external ? '↗' : '→'}</small>
          </a>
        ))}
      </div>
    </section>
  )}

  {rants.length > 0 && (
    <section id="rants" class="block">
      <div class="sh"><h2>发发神经</h2><a class="ulink" href="/rants/">全部 →</a></div>
      <a class="rants" href="/rants/" data-cursor="去看看">
        <div class="rline" id="rline">
          {[0, 1].map(() => rants.slice(0, 6).map((r) => (
            <span><em>{r.data.mood ?? '💬'}</em>{r.body?.trim().split('\n')[0]}<small class="mono">{fmtDay(r.data.date)}</small></span>
          )))}
        </div>
      </a>
    </section>
  )}
</Base>

<style>
  .hero { height: 100vh; min-height: 720px; display: grid; grid-template-columns: 1.2fr 1fr; align-items: end; gap: 48px; padding: 0 var(--pad) 64px; }
  .hero h1 { font-size: clamp(120px, 14vw, 260px); line-height: .82; letter-spacing: -.06em; font-weight: 850; white-space: nowrap; }
  .sub { margin-top: 28px; font-size: 22px; line-height: 1.5; max-width: 560px; }
  .now { margin-top: 22px; display: flex; align-items: center; gap: 10px; color: var(--mute); font-size: 15px; }
  .now i { width: 8px; height: 8px; border-radius: 50%; background: var(--hot); animation: blink 1.4s infinite; }
  @keyframes blink { 50% { opacity: .25; } }
  .screen { position: relative; aspect-ratio: 16/10; border-radius: 6px; overflow: hidden; background: #111; align-self: center; color: #fff; animation: unclip 1.4s var(--ease) .3s backwards; }
  @keyframes unclip { from { clip-path: inset(0 0 100% 0); } }
  .screen img, .screen video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .screen .feed { position: absolute; inset: -20%; background: conic-gradient(from 0deg at 50% 50%, #ff4b1f, #ffb199, #3d5afe, #00a37a, #ff4b1f); filter: blur(40px) saturate(1.2); animation: spin 14s linear infinite; }
  .screen.idle .feed { filter: blur(50px) saturate(.9) brightness(.85); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .screen::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.65) 0%, rgba(0,0,0,0) 45%), linear-gradient(to bottom, rgba(0,0,0,.35) 0%, rgba(0,0,0,0) 20%); pointer-events: none; }
  .screen .rec, .screen .title, .screen .hud { z-index: 1; }
  .screen .grain { position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, .08) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; }
  .screen .rec { position: absolute; left: 18px; top: 16px; font: 600 13px ui-monospace, Menlo, monospace; display: flex; gap: 8px; align-items: center; }
  .screen .rec i { width: 9px; height: 9px; border-radius: 50%; background: #ff2d2d; animation: blink 1s infinite; }
  .screen .title { position: absolute; left: 18px; right: 18px; bottom: 44px; font-size: 28px; font-weight: 700; line-height: 1.25; text-shadow: 0 2px 20px rgba(0, 0, 0, .3); }
  .screen .hud { position: absolute; left: 18px; right: 18px; bottom: 16px; display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; }
  .block { margin-top: 140px; }
  .reel { height: 100vh; overflow: hidden; margin-top: 20px; }
  .track { display: flex; gap: 28px; padding: 0 var(--pad); height: 100%; align-items: center; will-change: transform; }
  .track .vcard { flex: none; width: 44vw; max-width: 760px; }
  .reel-end { flex: none; width: 30vw; font-size: 56px; font-weight: 800; letter-spacing: -.04em; line-height: 1.05; }
  .reel-end a { border-bottom: 3px solid var(--hot); }
  .vgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px 28px; padding: 40px var(--pad) 0; }
  .rants { display: block; padding: 70px 0 20px; overflow: hidden; }
  .rline { display: flex; gap: 80px; white-space: nowrap; width: max-content; font-size: 56px; letter-spacing: -.02em; }
  .rline span { display: inline-flex; gap: 22px; align-items: center; }
  .rline em { font-style: normal; font-size: 40px; }
  .rline small { font-size: 14px; color: var(--mute); }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'
  gsap.registerPlugin(ScrollTrigger, SplitText)
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  // 名字逐字落下
  if (!reduce) {
    const split = new SplitText('#name', { type: 'chars' })
    gsap.from(split.chars, { yPercent: 110, rotate: 8, opacity: 0, stagger: .07, duration: 1.2, ease: 'expo.out' })
  }

  // 「正在做」轮换
  const nowEl = document.getElementById('now')!
  const nows: string[] = JSON.parse(nowEl.dataset.now || '[]')
  let ni = 0
  if (nows.length > 1 && !reduce) setInterval(() => {
    gsap.to(nowEl, { y: -10, opacity: 0, duration: .3, onComplete: () => {
      ni = (ni + 1) % nows.length; nowEl.textContent = nows[ni]
      gsap.fromTo(nowEl, { y: 10, opacity: 0 }, { y: 0, opacity: 1, duration: .5 })
    } })
  }, 2600)

  // 屏幕上的时间码
  const tc = document.getElementById('tc')
  let f = 0
  if (tc && !reduce) setInterval(() => {
    f++; const s = Math.floor(f / 25)
    tc.textContent = `00:${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}:${String(f % 25).padStart(2, '0')}`
  }, 40)

  // 视频：竖向滚动驱动横向移动
  const track = document.getElementById('track')
  if (track && !reduce) {
    gsap.to(track, { x: () => -(track.scrollWidth - innerWidth), ease: 'none', scrollTrigger: { trigger: '#reel', start: 'top top', end: () => '+=' + (track.scrollWidth - innerWidth), pin: true, scrub: 1, invalidateOnRefresh: true } })
  }

  // 大标题逐字
  if (document.querySelector('.big') && !reduce) {
    const big = new SplitText('.big', { type: 'chars' })
    gsap.from(big.chars, { yPercent: 100, opacity: 0, stagger: .03, duration: .9, ease: 'expo.out', scrollTrigger: { trigger: '.big', start: 'top 85%' } })
  }

  // 发发神经跑马灯：滚动越快转得越快
  const rline = document.getElementById('rline')
  if (rline && !reduce) {
    const loop = gsap.to(rline, { xPercent: -50, duration: 40, ease: 'none', repeat: -1 })
    ScrollTrigger.create({ onUpdate: (self) => {
      gsap.to(loop, { timeScale: 1 + Math.min(Math.abs(self.getVelocity()) / 300, 6), duration: .2, overwrite: true })
      gsap.to(loop, { timeScale: 1, duration: 1.2, delay: .2 })
    } })
  }

  // 视频卡片悬停播放预览片段
  document.querySelectorAll<HTMLVideoElement>('video[data-hover-preview]').forEach((v) => {
    const card = v.closest('.vcard')!
    card.addEventListener('mouseenter', () => { v.preload = 'auto'; v.play().catch(() => {}) })
    card.addEventListener('mouseleave', () => v.pause())
  })
</script>
