---
import Base from '../layouts/Base.astro'
import Foot from '../components/Foot.astro'
import site from '../data/site.json'
import { opt } from '../lib/img'
import { render } from 'astro:content'
import { getVideos, getRants, getNoteRows, getArticleRows, getProjects, projectPageHref, videoHref, thumb, fmtDay } from '../lib/content'

const [videos, rants, rows, articles, projects] = await Promise.all([getVideos(), getRants(), getNoteRows(), getArticleRows(), getProjects()])
const latestVideos = videos.slice(0, 4)
const writing = rows.slice(0, 4)
const latestRants = await Promise.all(rants.slice(0, 3).map(async (r) => ({ r, Content: (await render(r)).Content })))
let n = 0
const follow = site.follow.filter((f) => f.url || f.copy)
const no = () => String(++n).padStart(2, '0')
// 第一屏：IP 周围的入口。悬停时 IP 换成对应姿势、说一句介绍，入口下方浮出「数量 + 最新一条」
const clip = (t: string, len = 26) => (t.length > len ? t.slice(0, len) + '…' : t)
const plain = (md = '') => md.replace(/[#>*_`~\[\]()!-]/g, '').replace(/\s+/g, ' ').trim()
const entries = [
  projects.length > 0 && { href: '#projects', name: '项目', count: `${projects.length} 个`, ip: 'laptop', say: '这几个项目我正在做', tag: projects.some((p) => p.data.wip) ? '开发中' : '', latest: projects.map((p) => p.data.title).join(' · ') },
  rows.length > 0 && { href: '#notes', name: '笔记', count: `${rows.length} 篇`, ip: 'notes', say: '学到的都记在这里', tag: '最新', latest: clip(rows[0].title) },
  { href: '#articles', name: '文章', count: articles.length ? `${articles.length} 篇` : '', ip: 'point', say: '想清楚的写成文章', tag: articles.length ? '最新' : '', latest: articles.length ? clip(articles[0].title) : '第一篇正在写' },
  videos.length > 0 && { href: '#videos', name: '视频', count: `${videos.length} 支`, ip: 'present', say: '做的过程都拍下来了', tag: '最新', latest: clip(videos[0].data.title) },
  { href: '#rants', name: '发发神经', count: rants.length ? `${rants.length} 条` : '', ip: 'facepalm', say: '这里随便发发牢骚', tag: rants.length ? fmtDay(rants[0].data.date) : '', latest: rants.length ? clip(plain(rants[0].body)) : '今天很平静' },
  follow.length > 0 && { href: '#follow', name: '关注我', count: `${follow.length} 个平台`, ip: 'thumbs', say: '在这些地方都能找到我', tag: '', latest: follow.map((f) => f.name).join(' · ') },
].filter((e) => !!e)
// 左右交替摆放，左边锚在右边缘、右边锚在左边缘，展开详情时入口本身不变大
const slots = [[-340, -180], [340, -190], [-390, 50], [390, 40], [-400, 250], [400, 260]]
---
<Base>
  <section class="hero screen">
    <div class="glow"></div><div class="ring"></div>
    <nav class="orbit" aria-label="网站内容">
      {entries.map((e, i) => {
        const [x, y] = slots[i]
        return (
          <a href={e.href} class:list={['pill', x < 0 ? 'l' : 'r']} style={`left:${x}px; top:${y}px`} data-ip={e.ip} data-say={e.say}>
            <b>{e.name}</b>{e.count && <small>{e.count}</small>}
            <span class="pop">{e.tag && <i>{e.tag}</i>}{e.latest}</span>
          </a>
        )
      })}
    </nav>
    <div class="stage" id="stage" data-cursor="点我">
      <div class="bubble" id="bubble">嗨！点我一下 👋</div>
      <img src="/brand/wave.webp" alt="花萍雨的 IP 形象" data-k="wave" />
    </div>
    <div class="name">
      {site.role && <p class="role">{site.role}</p>}
      <h1 id="name">{site.name}<span class="dot">.</span></h1>
      <p class="sub">{site.tagline}</p>
    </div>
    {site.now.length > 0 && <p class="now"><i></i><span id="now" data-now={JSON.stringify(site.now)}>{site.now[0]}</span></p>}
  </section>

  {projects.length > 0 && (
    <section id="projects" class="screen">
      <div class="sh"><h2>{no()} · 项目</h2><span>正在做的 Agent 和工程项目</span></div>
      <div class="projects">
        {projects.map((p, i) => {
          const Tag = p.data.wip ? 'div' : 'a'
          return (
            <Tag class:list={['proj', 'reveal-scroll', { wip: p.data.wip }]} href={p.data.wip ? undefined : projectPageHref(p)} data-cursor={p.data.wip ? undefined : '看详情'}>
              <div class="pcover">{p.data.cover ? <img src={opt(p.data.cover)} alt="" loading="lazy" /> : <div class="bg" style={`background:${thumb(i)}`}></div>}</div>
              <div class="pmeta">
                <div class="ptop"><span class="pno">{String(i + 1).padStart(2, '0')}</span>{p.data.wip && <span class="pwip"><i></i>开发中</span>}{p.data.period && <span class="pperiod">{p.data.period}</span>}</div>
                <h3>{p.data.title}</h3>
                <p class="ptag">{p.data.tagline}</p>
                {p.data.stack.length > 0 && <div class="pstack">{p.data.stack.map((t) => <span>{t}</span>)}</div>}
                {!p.data.wip && <span class="pgo">项目详情 →</span>}
              </div>
            </Tag>
          )
        })}
      </div>
    </section>
  )}

  {writing.length > 0 && (
    <section id="notes" class="screen">
      <div class="sh"><h2>{no()} · 笔记</h2><a class="ulink" href="/notes/">全部 {rows.length} 篇 →</a></div>
      <div class="notes-wrap">
        <div class="notes-ip">
          <img src="/brand/notes.webp" alt="" loading="lazy" />
          <p>边学边记，<br />一直在更新。</p>
        </div>
        <div class="notes-list">
          {writing.map((r) => (
            <a class="nrow reveal-scroll" href={r.href} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener' : undefined}>
              <span class="nk">{r.kind}</span>
              <h3>{r.title}</h3>
              <span class="nm">{r.meta}</span>
              <span class="ngo">→</span>
            </a>
          ))}
          {rows.length < 4 && <p class="nmore">更多笔记正在整理，会陆续放上来。</p>}
        </div>
      </div>
    </section>
  )}

  <section id="articles" class="screen">
    <div class="sh"><h2>{no()} · 文章</h2><a class="ulink" href="/articles/">{articles.length ? `全部 ${articles.length} 篇 →` : '去看看 →'}</a></div>
    <div class="notes-wrap">
      <div class="notes-ip">
        <img src="/brand/point.webp" alt="" loading="lazy" />
        <p>想清楚了，<br />就写成完整的文章。</p>
      </div>
      <div class="notes-list">
        {articles.slice(0, 4).map((r) => (
          <a class="nrow reveal-scroll" href={r.href} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener' : undefined}>
            <span class="nk">{r.kind}{r.draft && ' · 草稿'}</span>
            <h3>{r.title}</h3>
            <span class="nm">{r.meta}</span>
            <span class="ngo">{r.external ? '↗' : '→'}</span>
          </a>
        ))}
        {articles.length === 0 && <p class="nmore">第一篇文章正在写，写好就放上来。</p>}
      </div>
    </div>
  </section>

  {videos.length > 0 && (
    <section id="videos" class="screen">
      <div class="sh"><h2>{no()} · 视频</h2><a class="ulink" href="/videos/">全部 {videos.length} 支 →</a></div>
      <div class="vgrid">
        {latestVideos.map((v, i) => (
          <a class="vcard reveal-scroll" href={videoHref(v)} data-cursor="播放">
            <div class="frame">
              {v.data.cover ? <img src={opt(v.data.cover)} alt="" loading="lazy" /> : <div class="bg" style={`background:${thumb(i)}`}></div>}
              {v.data.preview && <video src={v.data.preview} muted loop playsinline preload="none" data-hover-preview></video>}
              {v.data.duration && <span class="len mono">{v.data.duration}</span>}
            </div>
            <div class="meta"><span>{v.data.tags[0] ?? v.data.platform}</span><span>{fmtDay(v.data.date)}{v.data.draft && ' · 草稿'}</span></div>
            <h3>{v.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <section id="rants" class="screen">
    <div class="sh"><h2>{no()} · 发发神经</h2><a class="ulink" href="/rants/">{rants.length ? `全部 ${rants.length} 条 →` : '去看看 →'}</a></div>
    <div class="rants-wrap">
      <div class="rants-ip">
        <img src="/brand/facepalm.webp" alt="" loading="lazy" />
        <p>牢骚、碎碎念，<br />情绪总得有个出口。</p>
      </div>
      <div class="rants-list">
        {latestRants.length ? latestRants.map(({ r, Content }) => (
          <a class="rcard reveal-scroll" href="/rants/">
            <span class="rmood">{r.data.mood ?? '💬'}</span>
            <div class="rbody"><Content /></div>
            <time class="mono">{fmtDay(r.data.date)}{r.data.draft && ' · 草稿'}</time>
          </a>
        )) : <p class="nmore">今天很平静，还没有发神经。</p>}
      </div>
    </div>
  </section>
  {follow.length > 0 && (
    <section id="follow" class="screen follow">
      <div class="sh"><h2>{no()} · 关注我</h2><span>视频在 B 站、抖音、小红书同步更新，长文写在知乎</span></div>
      <div class="follow-wrap">
        <div class="follow-ip">
          <img src="/brand/wave.webp" alt="" loading="lazy" />
          <p>来打个招呼，<br />在这些地方都能找到我。</p>
        </div>
        <div class="fgrid">
          {follow.map((f) => {
            const Tag = f.url ? 'a' : 'button'
            return (
              <Tag class="fcard reveal-scroll" href={f.url || undefined} target={f.url.startsWith('http') ? '_blank' : undefined} rel={f.url ? 'noopener' : undefined} data-copy={f.url ? undefined : f.copy} data-cursor={f.url ? '去看看' : '点击复制'}>
                <span class="fname">{f.name}</span>
                {f.desc && <span class="fdesc">{f.desc}</span>}
                <span class="fhandle">{f.handle ? (f.url ? `@${f.handle}` : f.handle) : ''}</span>
                <span class="fgo">{f.url ? '↗' : '⧉'}</span>
              </Tag>
            )
          })}
        </div>
      </div>
      <div class="follow-foot"><Foot /></div>
    </section>
  )}
</Base>

<style is:global>
  /* 首页：一屏只放一块内容，滚动时吸附到整屏 */
  html { scroll-snap-type: y mandatory; }
</style>

<style>
  .screen { min-height: 100vh; scroll-snap-align: start; display: flex; flex-direction: column; justify-content: center; padding: 90px 0 50px; }
  .screen > .sh { margin-bottom: 10px; }
  .hero { position: relative; align-items: center; perspective: 1200px; overflow: hidden; padding-top: 60px; padding-bottom: 60px; }
  .glow { position: absolute; left: 50%; top: 50%; width: 620px; height: 620px; border-radius: 50%; transform: translate(-50%, -50%); background: radial-gradient(closest-side, color-mix(in srgb, var(--hot) 40%, transparent), transparent); filter: blur(20px); pointer-events: none; }
  .ring { position: absolute; left: 50%; top: 50%; width: 760px; height: 760px; border: 1.5px dashed var(--line); border-radius: 50%; transform: translate(-50%, -54%); animation: ringSpin 60s linear infinite; pointer-events: none; }
  @keyframes ringSpin { to { transform: translate(-50%, -54%) rotate(360deg); } }
  .orbit { position: absolute; left: 50%; top: 50%; z-index: 2; }
  /* 入口大小固定，悬停区域稳定；详情是另一张浮层，不占位、不接收鼠标 */
  .pill { position: absolute; display: flex; align-items: baseline; gap: 8px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 12px 20px; box-shadow: 0 10px 24px -16px rgba(28, 33, 64, .5); white-space: nowrap; transition: background .25s, box-shadow .3s; animation: pillIn .8s var(--ease) backwards; }
  .pill:nth-child(2) { animation-delay: .08s; } .pill:nth-child(3) { animation-delay: .16s; } .pill:nth-child(4) { animation-delay: .24s; } .pill:nth-child(5) { animation-delay: .32s; } .pill:nth-child(6) { animation-delay: .4s; }
  @keyframes pillIn { from { opacity: 0; } }
  .pill.l { transform: translate(-100%, -50%); }
  .pill.r { transform: translate(0, -50%); }
  .pill b { font-size: 18px; }
  .pill small { color: var(--mute); font-size: 13px; transition: color .25s; }
  .pill .pop { position: absolute; top: calc(100% + 10px); width: 250px; padding: 12px 16px; border-radius: 14px; background: var(--ink); color: var(--paper); font-size: 13px; line-height: 1.55; white-space: normal; pointer-events: none; opacity: 0; transform: translateY(-4px); transition: opacity .25s, transform .3s var(--ease); }
  .pill.l .pop { right: 0; }
  .pill.r .pop { left: 0; }
  .pill .pop i { font-style: normal; color: var(--hot); font-weight: 700; margin-right: 6px; }
  .pill:hover { background: var(--hot); box-shadow: 0 16px 30px -18px rgba(28, 33, 64, .6); }
  .pill:hover small { color: var(--ink); }
  .pill:hover .pop { opacity: 1; transform: none; transition-delay: .08s; }
  .stage { position: relative; z-index: 1; width: 380px; height: min(440px, 48vh); margin-top: 40px; transform-style: preserve-3d; will-change: transform; animation: stageIn 1.2s var(--ease) .1s backwards; }
  @keyframes stageIn { from { opacity: 0; transform: translateY(30px) scale(.94); } }
  .stage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity .2s ease .13s; }
  .stage img.off { opacity: 0; transition: opacity .13s ease; }
  .bubble { position: absolute; left: 50%; top: -6px; z-index: 3; transform: translate(-50%, -100%); background: var(--ink); color: var(--paper); padding: 12px 18px; border-radius: 18px; font-weight: 700; font-size: 16px; white-space: nowrap; transition: transform .35s var(--ease), opacity .15s; }
  .bubble::after { content: ''; position: absolute; left: 50%; bottom: -7px; width: 14px; height: 14px; background: var(--ink); transform: translateX(-50%) rotate(45deg); }
  .bubble.fade { opacity: 0; }
  .bubble.pop { transform: translate(-50%, -100%) scale(1.08); }
  .name { position: relative; z-index: 2; text-align: center; margin-top: 12px; }
  .role { font-size: 15px; font-weight: 600; color: var(--navy); }
  .hero h1 { font-size: 60px; letter-spacing: -.05em; font-weight: 850; line-height: 1.05; }
  .sub { color: var(--mute); font-size: 16px; line-height: 1.6; margin: 6px auto 0; max-width: 500px; }
  .now { position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--mute); }
  .now i { width: 8px; height: 8px; border-radius: 50%; background: var(--hot); animation: blink 1.4s infinite; }
  @keyframes blink { 50% { opacity: .25; } }


  /* 项目：三列卡片 */
  .projects { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 30px var(--pad) 0; }
  .proj { display: flex; flex-direction: column; background: var(--paper2); border-radius: 18px; overflow: hidden; transition: transform .5s var(--ease), box-shadow .5s var(--ease); }
  a.proj:hover { transform: translateY(-6px); box-shadow: 0 30px 60px rgba(19, 28, 70, .12); }
  .pcover { position: relative; height: min(32vh, 300px); background: linear-gradient(180deg, color-mix(in srgb, var(--hot) 18%, var(--paper2)), var(--paper2)); }
  .pcover img { position: absolute; inset: 16px 20px 0; width: calc(100% - 40px); height: calc(100% - 16px); object-fit: contain; object-position: bottom; transition: transform .8s var(--ease); }
  .pcover .bg { position: absolute; inset: 0; }
  .proj:hover .pcover img { transform: scale(1.04) rotate(-1.5deg); }
  .pmeta { padding: 20px 28px 28px; display: flex; flex-direction: column; flex: 1; }
  .ptop { display: flex; align-items: center; gap: 12px; font-size: 14px; }
  .pno { font-weight: 700; color: var(--navy); }
  .pwip { display: inline-flex; align-items: center; gap: 6px; background: var(--night); color: var(--paper); border-radius: 999px; padding: 3px 10px 3px 8px; font-size: 12px; font-weight: 600; }
  .pwip i { width: 7px; height: 7px; border-radius: 50%; background: var(--hot); animation: blink 1.4s infinite; }
  .pperiod { color: var(--mute); }
  .proj h3 { font-size: 30px; letter-spacing: -.03em; line-height: 1.15; margin-top: 10px; }
  .ptag { font-size: 16px; line-height: 1.7; margin-top: 12px; color: #3d4160; }
  .pstack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 20px; }
  .pstack span { border: 1px solid var(--ink); border-radius: 999px; padding: 3px 11px; font-size: 12px; font-weight: 600; }
  .pgo { margin-top: 20px; font-weight: 700; border-bottom: 2px solid var(--hot); align-self: flex-start; }

  /* 笔记：左边 IP 形象，右边列表 */
  .notes-wrap { display: grid; grid-template-columns: 1fr 2fr; gap: 50px; align-items: center; padding: 30px var(--pad) 0; }
  .notes-ip { text-align: center; }
  .notes-ip img { width: min(100%, 340px); max-height: 46vh; object-fit: contain; margin: 0 auto; }
  .notes-ip p { margin-top: 18px; font-size: 26px; font-weight: 700; line-height: 1.4; letter-spacing: -.01em; }
  .notes-list { display: grid; gap: 14px; }
  .nrow { display: grid; grid-template-columns: 80px 1fr auto 30px; align-items: center; gap: 16px; padding: 26px 28px; border-radius: 14px; background: #fff; border: 1px solid var(--line); transition: transform .4s var(--ease), border-color .3s, box-shadow .4s; }
  .nrow:hover { transform: translateX(6px); border-color: var(--navy); box-shadow: 0 20px 40px rgba(19, 28, 70, .08); }
  .nrow .nk { font-size: 13px; font-weight: 700; color: var(--navy); }
  .nrow h3 { font-size: 24px; letter-spacing: -.01em; }
  .nrow .nm { font-size: 14px; color: var(--mute); }
  .nrow .ngo { font-size: 20px; text-align: right; }
  .nmore { padding: 22px 28px; border-radius: 14px; border: 1.5px dashed var(--line); color: var(--mute); font-size: 15px; }

  /* 视频：普通网格，不锁滚动 */
  .vgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; padding: 30px var(--pad) 0; }
  .vgrid .vcard h3 { font-size: 18px; line-height: 1.45; }

  .rants-wrap { display: grid; grid-template-columns: 1fr 2fr; gap: 50px; align-items: center; padding: 30px var(--pad) 0; }
  .rants-ip { text-align: center; }
  .rants-ip img { width: min(100%, 300px); max-height: 46vh; object-fit: contain; margin: 0 auto; }
  .rants-ip p { margin-top: 18px; font-size: 26px; font-weight: 700; line-height: 1.4; }
  .rants-list { display: grid; gap: 14px; }
  .follow { padding-bottom: 28px; }
  .follow-wrap { display: grid; grid-template-columns: 1fr 2fr; gap: 50px; align-items: center; padding: 30px var(--pad) 0; flex: 1; }
  .follow-ip { text-align: center; }
  .follow-ip img { width: min(100%, 300px); max-height: 46vh; object-fit: contain; margin: 0 auto; transform-origin: 30% 70%; }
  .follow:hover .follow-ip img { animation: wave 1.2s var(--ease); }
  .follow-ip p { margin-top: 18px; font-size: 26px; font-weight: 700; line-height: 1.4; }
  .fgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .fcard { position: relative; display: grid; text-align: left; font: inherit; color: inherit; grid-template-rows: auto 1fr auto; min-height: 160px; padding: 26px 28px; border-radius: 18px; background: #fff; border: 1px solid var(--line); transition: transform .4s var(--ease), background .3s, border-color .3s, box-shadow .4s; }
  .fcard.copied .fgo { color: var(--ink); }
  .fname { font-size: 30px; font-weight: 800; letter-spacing: -.02em; }
  .fdesc { color: var(--mute); font-size: 15px; margin-top: 6px; }
  .fhandle { color: var(--navy); font-size: 14px; font-weight: 600; }
  .fgo { position: absolute; right: 24px; top: 22px; font-size: 22px; color: var(--mute); transition: transform .4s var(--ease), color .3s; }
  .fcard:hover { transform: translateY(-4px); background: var(--hot); border-color: var(--hot); box-shadow: 0 18px 40px -22px rgba(28, 33, 64, .45); }
  .fcard:hover .fdesc, .fcard:hover .fhandle, .fcard:hover .fgo { color: var(--ink); }
  .fcard:hover .fgo { transform: translate(3px, -3px); }
  .follow-foot { margin: 40px var(--pad) 0; padding-top: 18px; border-top: 1px solid var(--line); }
  @keyframes wave { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-6deg); } 50% { transform: rotate(4deg); } 75% { transform: rotate(-2deg); } }
  .rcard { display: grid; grid-template-columns: 50px 1fr auto; gap: 18px; align-items: start; padding: 24px 28px; border-radius: 6px 20px 20px 20px; background: #fff; border: 1px solid var(--line); transition: transform .4s var(--ease), border-color .3s; }
  .rcard:hover { transform: translateX(6px); border-color: var(--navy); }
  .rmood { font-size: 30px; line-height: 1; }
  .rbody { font-size: 20px; line-height: 1.6; font-weight: 600; }
  .rbody :global(p + p) { margin-top: .4em; }
  .rcard time { font-size: 13px; color: var(--mute); padding-top: 4px; }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  // 「正在做」轮换
  const nowEl = document.getElementById('now')
  const nows: string[] = JSON.parse(nowEl?.dataset.now || '[]')
  let ni = 0
  if (nowEl && nows.length > 1 && !reduce) setInterval(() => {
    gsap.to(nowEl, { y: -8, opacity: 0, duration: .3, onComplete: () => {
      ni = (ni + 1) % nows.length; nowEl.textContent = nows[ni]
      gsap.fromTo(nowEl, { y: 8, opacity: 0 }, { y: 0, opacity: 1, duration: .5 })
    } })
  }, 2600)

  // 第一屏 IP：点他换表情；指向入口时换成对应姿势并介绍
  const stage = document.getElementById('stage')!
  const bubble = document.getElementById('bubble')!
  const imgs: Record<string, HTMLImageElement> = { wave: stage.querySelector('img')! }
  let curPose = 'wave'
  const pose = (k: string) => {
    if (k === curPose) return
    curPose = k
    let img = imgs[k]
    if (!img) { img = imgs[k] = new Image(); img.src = `/brand/${k}.webp`; img.alt = ''; img.className = 'off'; stage.appendChild(img) }
    Object.values(imgs).forEach((x) => x.classList.add('off'))
    requestAnimationFrame(() => img.classList.remove('off'))
  }
  // 气泡先淡出再换字，连续触发时只保留最后一次
  let sayTo = bubble.textContent, sayT = 0
  const say = (t: string, popIt = false) => {
    if (t === sayTo) return
    sayTo = t; clearTimeout(sayT); bubble.classList.add('fade')
    sayT = window.setTimeout(() => {
      bubble.textContent = t; bubble.classList.remove('fade')
      if (popIt) { bubble.classList.add('pop'); setTimeout(() => bubble.classList.remove('pop'), 250) }
    }, 150)
  }
  const clicks = [['wave', '嗨！点我一下 👋'], ['idea', '想到一个点子！'], ['chin', '让我想想…'], ['thumbs', '你能看到这里，很棒'], ['facepalm', '这个 bug 又是我写的'], ['laptop', '我先去写代码了']]
  let ci = 0, hovering = false, enterT = 0, leaveT = 0
  stage.addEventListener('click', () => { ci = (ci + 1) % clicks.length; if (!hovering) { pose(clicks[ci][0]); say(clicks[ci][1], true) } })
  // 停留 120ms 才换姿势（划过不触发）；离开 300ms 后才回到原表情（在入口之间移动不来回闪）
  document.querySelectorAll<HTMLElement>('.pill').forEach((p) => {
    new Image().src = `/brand/${p.dataset.ip}.webp`
    p.addEventListener('mouseenter', () => {
      clearTimeout(leaveT); clearTimeout(enterT)
      enterT = window.setTimeout(() => { hovering = true; pose(p.dataset.ip!); say(p.dataset.say!) }, 120)
    })
    p.addEventListener('mouseleave', () => {
      clearTimeout(enterT)
      leaveT = window.setTimeout(() => { hovering = false; pose(clicks[ci][0]); say(clicks[ci][1]) }, 300)
    })
  })
  // 转身：角度每帧缓慢靠近鼠标方向，动作连贯不抖
  if (!reduce) {
    let tx = 0, ty = 0, cx = 0, cy = 0
    addEventListener('pointermove', (e) => { if (e.pointerType !== 'mouse') return; tx = (e.clientX / innerWidth - .5) * 14; ty = (e.clientY / innerHeight - .5) * -9 })
    const loop = () => {
      cx += (tx - cx) * .08; cy += (ty - cy) * .08
      if (Math.abs(tx - cx) > .01 || Math.abs(ty - cy) > .01) stage.style.transform = `rotateY(${cx.toFixed(2)}deg) rotateX(${cy.toFixed(2)}deg)`
      requestAnimationFrame(loop)
    }
    loop()
  }

  // 视频卡片悬停播放预览片段
  document.querySelectorAll<HTMLVideoElement>('video[data-hover-preview]').forEach((v) => {
    const card = v.closest('.vcard')!
    card.addEventListener('mouseenter', () => { v.preload = 'auto'; v.play().catch(() => {}) })
    card.addEventListener('mouseleave', () => v.pause())
  })
  // 「关注我」里的微信卡片：点击复制微信号，光标提示和卡片角标都给反馈
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
    el.addEventListener('click', async () => {
      await navigator.clipboard.writeText(el.dataset.copy || '')
      const go = el.querySelector('.fgo')!
      el.dataset.cursor = '已复制，去微信添加吧'
      document.getElementById('cur-label')!.textContent = el.dataset.cursor
      go.textContent = '✓'
      setTimeout(() => { go.textContent = '⧉'; el.dataset.cursor = '点击复制' }, 2000)
    })
  })
</script>
