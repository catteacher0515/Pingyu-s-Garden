---
import { render } from 'astro:content'
import Base from '../layouts/Base.astro'
import { getRants } from '../lib/content'

const rants = await getRants()
const items = await Promise.all(rants.map(async (r) => ({ r, Content: (await render(r)).Content })))
const fmt = (d: Date) => d.toLocaleString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Shanghai' })
---
<Base title="发发神经" nav="rants" description="花萍雨的牢骚、碎碎念和一些小感悟。">
  <header class="page-head">
    <p class="eyebrow">发发神经 · {rants.length} 条</p>
    <h1>发发神经<span class="dot">.</span></h1>
    <p>牢骚、碎碎念和偶尔冒出来的小感悟。<span class="serif">情绪总得有个出口。</span></p>
  </header>
  {items.length ? (
    <ol class="rants">
      {items.map(({ r, Content }) => (
        <li class="reveal-scroll">
          <span class="mood">{r.data.mood ?? '💬'}</span>
          <div class="body"><Content /></div>
          <time class="mono">{fmt(r.data.date)}{r.data.draft && ' · 草稿'}</time>
        </li>
      ))}
    </ol>
  ) : <p class="empty">今天很平静，还没有发神经。</p>}
</Base>

<style>
  .rants { list-style: none; padding: 0 var(--pad); }
  .rants li { display: grid; grid-template-columns: 80px 1fr 200px; gap: 24px; align-items: baseline; padding: 40px 0; border-top: 1px solid var(--line); }
  .mood { font-size: 44px; line-height: 1; }
  .body { font-size: 34px; line-height: 1.45; letter-spacing: -.01em; font-weight: 600; max-width: 980px; }
  .body :global(p + p) { margin-top: .5em; }
  .body :global(img) { border-radius: 6px; margin-top: 16px; max-width: 520px; }
  time { color: var(--mute); font-size: 13px; text-align: right; }
</style>
