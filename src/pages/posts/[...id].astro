---
import { render } from 'astro:content'
import Article from '../../layouts/Article.astro'
import { opt } from '../../lib/img'
import { getPosts, fmtDay, type Post } from '../../lib/content'

export async function getStaticPaths() {
  return (await getPosts()).filter((p) => !p.data.external).map((p) => ({ params: { id: p.id }, props: { post: p } }))
}
const { post } = Astro.props as { post: Post }
const { Content, headings } = await render(post)
const d = post.data
---
<Article title={d.title} description={d.summary} image={opt(d.cover)} nav="writing" back={{ href: '/writing/', label: '教程 & 笔记' }} toc={headings.filter((h) => h.depth <= 3).map((h) => ({ id: h.slug, text: h.text, depth: h.depth }))}>
  <Fragment slot="meta">
    <span>{d.category}</span>{d.date && <span>{fmtDay(d.date)}</span>}{d.tags.map((t) => <span>#{t}</span>)}
    {d.draft && <span class="draft-badge">草稿 · 仅本地可见</span>}
  </Fragment>
  {d.cover && <img src={opt(d.cover)} alt="" />}
  {d.summary && <p class="lead">{d.summary}</p>}
  <Content />
</Article>

<style>
  .lead { font-size: 22px; line-height: 1.6; }
</style>
