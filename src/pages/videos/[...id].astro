---
import { render } from 'astro:content'
import Article from '../../layouts/Article.astro'
import site from '../../data/site.json'
import { opt } from '../../lib/img'
import { getVideos, videoHref, fmtFull, type Video } from '../../lib/content'

export async function getStaticPaths() {
  const videos = await getVideos()
  // 列表按时间倒序：前一项是更新的「下一支」，后一项是更早的「上一支」
  return videos.map((v, i) => ({ params: { id: v.id }, props: { video: v, newer: videos[i - 1], older: videos[i + 1] } }))
}
const { video, newer, older } = Astro.props as { video: Video; newer?: Video; older?: Video }
const { Content, headings } = await render(video)
const d = video.data
// 网站里不嵌播放器（B 站外链播放器只有 360P，点画面还会跳走），封面和章节都直接在新标签页打开平台原视频
const toSec = (at: string) => at.split(':').reduce((s, n) => s * 60 + Number(n), 0)
const at = (sec: number) => { const u = new URL(d.url); u.searchParams.set('t', String(sec)); return u.href }
// 很多视频的说明正文就是以简介开头的，这种情况不再单独显示简介，避免同一句话出现两次
const flat = (s = '') => s.replace(/\s+/g, '')
const showLead = d.summary && !flat(video.body).startsWith(flat(d.summary).slice(0, 20))
// 同一支视频也发在抖音、小红书，这里链到这两个平台的主页
const mirrors = site.follow.filter((f) => f.url && ['抖音', '小红书'].includes(f.name) && f.name !== d.platform)
---
<Article title={d.title} description={d.summary} image={opt(d.cover)} nav="videos" back={{ href: '/videos/', label: '全部视频' }} toc={headings.map((h) => ({ id: h.slug, text: h.text, depth: h.depth }))}>
  <Fragment slot="meta">
    <span>{fmtFull(d.date)}</span>{d.duration && <span>{d.duration}</span>}{d.series && <span>{d.series}</span>}{d.tags.map((t) => <span>#{t}</span>)}
    {d.draft && <span class="draft-badge">草稿 · 仅本地可见</span>}
  </Fragment>
  <div slot="hero" class="player">
    <a class="cover" href={d.url} target="_blank" rel="noopener" data-cursor="去看">
      {d.cover && <img src={opt(d.cover)} alt="" />}
      <span class="play" aria-hidden="true">▶</span>
      <span class="hint">去{d.platform}播放（高清 · 新标签页打开）↗</span>
    </a>
    {d.chapters.length > 1 && (
      <ol class="chapters" aria-label="章节，点击后从这里开始播放">
        {d.chapters.map((c) => <li><a href={at(toSec(c.at))} target="_blank" rel="noopener"><time>{c.at}</time>{c.title}</a></li>)}
      </ol>
    )}
    <p class="watch">
      <a class="ulink" href={d.url} target="_blank" rel="noopener">喜欢的话，去{d.platform}一键三连 ↗</a>
      {mirrors.length > 0 && <span>也发在{mirrors.map((m) => <a class="ulink" href={m.url} target="_blank" rel="noopener">{m.name}</a>)}</span>}
    </p>
  </div>
  {showLead && <p class="lead">{d.summary}</p>}
  <Content />
  <nav slot="after" class="pager">
    {older ? <a href={videoHref(older)}><small>← 上一支</small><b>{older.data.title}</b></a> : <span></span>}
    {newer ? <a class="next" href={videoHref(newer)}><small>下一支 →</small><b>{newer.data.title}</b></a> : <span></span>}
  </nav>
</Article>

<style>
  .player { margin-bottom: 30px; }
  .cover { position: relative; display: block; aspect-ratio: 16/9; border-radius: 16px; overflow: hidden; background: #111; }
  .cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .cover:hover img { transform: scale(1.03); }
  .play { position: absolute; left: 50%; top: 50%; width: 84px; height: 84px; margin: -42px 0 0 -42px; border-radius: 50%; background: rgba(255, 255, 255, .92); color: #111; display: grid; place-items: center; font-size: 28px; transition: transform .3s; }
  .cover:hover .play { transform: scale(1.08); }
  .hint { position: absolute; left: 16px; bottom: 14px; padding: 6px 12px; border-radius: 999px; background: rgba(0, 0, 0, .6); color: #fff; font-size: 13px; }
  .chapters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; list-style: none; padding: 0; }
  .chapters a { display: inline-flex; align-items: baseline; gap: 8px; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; font-size: 14px; color: var(--ink); transition: border-color .25s, background .25s, color .25s; }
  .chapters a:hover { border-color: var(--ink); }
  .chapters time { font-size: 12px; color: var(--mute); font-variant-numeric: tabular-nums; }
  .watch { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-top: 18px; font-size: 15px; }
  .watch span { color: var(--mute); }
  .watch span a { margin-left: 12px; color: var(--ink); }
  .lead { font-size: 18px; line-height: 1.7; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding-top: 56px; }
  .pager a { display: block; padding: 20px 24px; border: 1px solid var(--line); border-radius: 16px; background: #fff; transition: transform .4s var(--ease), border-color .3s; }
  .pager a:hover { transform: translateY(-3px); border-color: var(--hot); }
  .pager .next { text-align: right; }
  .pager small { color: var(--mute); font-size: 13px; }
  .pager b { display: block; margin-top: 6px; font-size: 17px; line-height: 1.4; }
</style>

