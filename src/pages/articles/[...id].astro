---
import { render } from 'astro:content'
import Article from '../../layouts/Article.astro'
import { opt } from '../../lib/img'
import { getPosts, fmtFull, readMinutes, type Post } from '../../lib/content'

export async function getStaticPaths() {
  const posts = (await getPosts()).filter((p) => !p.data.external)
  // 列表按时间倒序：前一项是更新的「下一篇」，后一项是更早的「上一篇」
  return posts.map((p, i) => ({ params: { id: p.id }, props: { post: p, newer: posts[i - 1], older: posts[i + 1] } }))
}
const { post, newer, older } = Astro.props as { post: Post; newer?: Post; older?: Post }
const { Content, headings } = await render(post)
const d = post.data
const originHost = d.origin && (new URL(d.origin).hostname.includes('zhihu') ? '知乎' : new URL(d.origin).hostname)
---
<Article title={d.title} description={d.summary} image={opt(d.cover)} nav="articles" back={{ href: '/articles/', label: '全部文章' }} toc={headings.map((h) => ({ id: h.slug, text: h.text, depth: h.depth }))}>
  <Fragment slot="meta">
    {d.date && <span>{fmtFull(d.date)}</span>}<span>{readMinutes(post.body)} 分钟读完</span>{d.tags.map((t) => <span>#{t}</span>)}
    {d.draft && <span class="draft-badge">草稿 · 仅本地可见</span>}
  </Fragment>
  {d.summary && <p class="lead">{d.summary}</p>}
  <Content />
  {d.origin && <p class="origin">本文首发于<a href={d.origin} target="_blank" rel="noopener">{originHost} ↗</a>，这里是完整版。</p>}
  <nav slot="after" class="pager">
    {older ? <a href={`/articles/${older.id}/`}><small>← 上一篇</small><b>{older.data.title}</b></a> : <span></span>}
    {newer ? <a class="next" href={`/articles/${newer.id}/`}><small>下一篇 →</small><b>{newer.data.title}</b></a> : <span></span>}
  </nav>
</Article>

<style>
  .lead { font-size: 18px; line-height: 1.7; }
  .origin { margin-top: 48px !important; padding-top: 20px; border-top: 1px dashed var(--line); color: var(--mute); font-size: 14px; }
  .origin a { color: var(--navy); margin: 0 2px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding-top: 56px; }
  .pager a { display: block; padding: 20px 24px; border: 1px solid var(--line); border-radius: 16px; background: #fff; transition: transform .4s var(--ease), border-color .3s; }
  .pager a:hover { transform: translateY(-3px); border-color: var(--hot); }
  .pager .next { text-align: right; }
  .pager small { color: var(--mute); font-size: 13px; }
  .pager b { display: block; margin-top: 6px; font-size: 17px; line-height: 1.4; }
</style>
